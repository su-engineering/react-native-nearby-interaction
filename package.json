{
  "name": "@su-engineering/react-native-nearby-interaction",
  "version": "0.1.0-beta.1",
  "description": "iOS UWB accessory ranging for React Native, with a T-TAG BLE profile and external transports",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/su-engineering/react-native-nearby-interaction.git"
  },
  "homepage": "https://github.com/su-engineering/react-native-nearby-interaction#readme",
  "bugs": {
    "url": "https://github.com/su-engineering/react-native-nearby-interaction/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "ios",
    "plugin",
    "app.plugin.js",
    "react-native.config.js",
    "NearbyInteractionKit.podspec",
    "README.md",
    "docs",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx tests/run.ts",
    "codegen": "node scripts/codegen.cjs",
    "check": "npm run typecheck && npm test && npm run build && npm run codegen",
    "prepack": "npm run build",
    "pack:check": "node scripts/pack.cjs",
    "test:consumer": "node scripts/consumer.cjs",
    "release:check": "npm run check && npm run pack:check",
    "prepublishOnly": "npm run release:check"
  },
  "peerDependencies": {
    "react": "~19.2.0",
    "react-native": "~0.83.1",
    "@expo/config-plugins": "~55.0.6"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expo/config-plugins": "~55.0.6",
    "@types/react": "^19.2.0",
    "@types/node": "^22.0.0",
    "react": "19.2.0",
    "react-native": "0.83.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "codegenConfig": {
    "name": "NearbyInteractionSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "ios": {
      "modules": {
        "NearbyInteraction": {
          "className": "RNNearbyInteraction"
        }
      }
    }
  },
  "author": "SU Engineering",
  "keywords": [
    "react-native",
    "nearby-interaction",
    "uwb",
    "ultra-wideband",
    "ios",
    "truesense",
    "bluetooth"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org/"
  }
}
